{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLASHRECOVERY AI",
  "version": "0.1.0",
  "identifier": "ai.flashrecovery.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FLASHRECOVERY AI",
        "width": 1380,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0a0f1c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "USB flash drive data recovery",
    "copyright": "© FLASHRECOVERY AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "perMachine" }
    }
  }
}
